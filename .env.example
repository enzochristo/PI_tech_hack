# Copie este arquivo para ".env" (cp .env.example .env) e preencha. O ".env" NÃO vai para o git.
OPENAI_API_KEY=cole-sua-chave-aqui

# Gera a explicação por LLM automaticamente, sem precisar da flag --llm (on/off).
# Atenção: "on" envia os findings (caminhos, usuários, serviços) para a OpenAI a cada execução.
ENDPOINT_LLM=on

# Opcional: modelo da OpenAI (padrão gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
